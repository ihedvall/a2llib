Terminals unused in grammar

    A2L_INCLUDE


Grammar

    0 $accept: a2l_file EOL

    1 any_uint: UINT
    2         | HEX
    3         | INT

    4 any_int: INT
    5        | UINT
    6        | HEX

    7 any_float: FLOAT
    8          | INT
    9          | UINT
   10          | HEX

   11 int_list: %empty
   12         | int_list any_int

   13 uint_list: %empty
   14          | uint_list any_uint

   15 float_list: %empty
   16           | float_list any_float

   17 float_pair_list: %empty
   18                | float_pair_list any_float any_float

   19 float_string_list: %empty
   20                  | float_string_list any_float STRING

   21 float_range_list: %empty
   22                 | float_range_list any_float any_float STRING

   23 string_list: %empty
   24            | string_list STRING

   25 ident_or_keyword: IDENT
   26                 | A2L_VERSION
   27                 | BLOB
   28                 | CHARACTERISTIC
   29                 | CONVERSION
   30                 | CUSTOMER
   31                 | MEASUREMENT

   32 ident_list: %empty
   33           | ident_list ident_or_keyword

   34 key_value_list: %empty
   35               | key_value_list IDENT IDENT

   36 a2l_file: file_version project

   37 file_version: %empty
   38             | asap2_version
   39             | file_version a2ml_version

   40 annotation: A2L_BEGIN ANNOTATION annotation_attributes A2L_END ANNOTATION

   41 annotation_attributes: %empty
   42                      | annotation_attributes annotation_label
   43                      | annotation_attributes annotation_origin
   44                      | annotation_attributes annotation_text

   45 annotation_text: A2L_BEGIN ANNOTATION_TEXT string_list A2L_END ANNOTATION_TEXT

   46 ar_component: A2L_BEGIN AR_COMPONENT STRING ar_component_attribute A2L_END AR_COMPONENT

   47 ar_component_attribute: %empty
   48                       | ar_prototype_of

   49 axis_descr: A2L_BEGIN AXIS_DESCR IDENT IDENT IDENT any_uint any_float any_float axis_descr_attributes A2L_END AXIS_DESCR

   50 axis_descr_attributes: %empty
