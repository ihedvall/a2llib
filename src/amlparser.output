Grammar

    0 $accept: aml_section $end

    1 aml_section: %empty
    2            | A2ML_BEGIN A2ML declaration_list A2ML_END A2ML
    3            | A2ML_BEGIN A2ML include_file A2ML_END A2ML

    4 declaration_list: %empty
    5                 | declaration
    6                 | declaration_list declaration

    7 declaration: type_definition def_end
    8            | block_definition def_end

    9 type_definition: type_name

   10 type_name: predefined_type_name
   11          | struct_type_name
   12          | taggedstruct_type_name
   13          | taggedunion_type_name
   14          | enum_type_name

   15 predefined_type_name: data_type array_specifier
   16                     | MEM_BEGIN data_type array_specifier def_end MEM_END

   17 data_type: CHAR
   18          | INT
   19          | LONG
   20          | INT64
   21          | UCHAR
   22          | UINT
   23          | UINT64
   24          | ULONG
   25          | DOUBLE
   26          | FLOAT
   27          | TEXT_ARRAY

   28 block_definition: BLOCK tag member def_end
   29                 | BLOCK tag MEM_BEGIN member MEM_END

   30 enum_type_name: ENUM identifier BLOCK_BEGIN enumerator_list BLOCK_END
   31               | ENUM IDENT

   32 enumerator_list: enumerator
   33                | enumerator_list COMMA enumerator

   34 enumerator: keyword
   35           | keyword EQUAL CONSTANT

   36 struct_type_name: STRUCT identifier BLOCK_BEGIN struct_member_list BLOCK_END
   37                 | STRUCT identifier

   38 struct_member_list: %empty
   39                   | struct_member
   40                   | struct_member_list struct_member

   41 struct_member: member def_end
   42              | MEM_BEGIN member MEM_END
   43              | block_definition def_end

   44 member: type_name array_specifier

   45 taggedstruct_type_name: TAGGED_STRUCT identifier BLOCK_BEGIN taggedstruct_member_list BLOCK_END
   46                       | TAGGED_STRUCT IDENT

   47 taggedstruct_member_list: %empty
   48                         | taggedstruct_member
   49                         | taggedstruct_member_list taggedstruct_member

   50 taggedstruct_member: taggedstruct_definition def_end
   51                    | MEM_BEGIN taggedstruct_definition MEM_END def_end
   52                    | block_definition def_end
   53                    | MEM_BEGIN block_definition MEM_END def_end

   54 taggedstruct_definition: tag
   55                        | tag member def_end
   56                        | tag MEM_BEGIN member MEM_END

   57 taggedunion_type_name: TAGGED_UNION identifier BLOCK_BEGIN taggedunion_member_list BLOCK_END
   58                      | TAGGED_UNION IDENT

   59 taggedunion_member_list: %empty
   60                        | taggedunion_member
   61                        | taggedunion_member_list taggedunion_member

   62 taggedunion_member: tag member def_end
   63                   | tag def_end
   64                   | block_definition def_end

   65 array_specifier: %empty
   66                | array
   67                | array_specifier array

   68 array: ARRAY_BEGIN CONSTANT ARRAY_END

   69 keyword: STRING

   70 identifier: %empty
   71           | IDENT

   72 tag: STRING

   73 def_end: %empty
   74        | DEF_END

   75 include_file: INCLUDE STRING


