    SINGLE


Grammar

    0 $accept: ccp_data_block $end

    1 ccp_data_block: BLOCK_BEGIN IF_DATA if_data BLOCK_END IF_DATA

    2 if_data: ASAP1B_CCP definitions

    3 definitions: %empty
    4            | definitions definition

    5 definition: source
    6           | raster
    7           | event_group
    8           | seed_key
    9           | checksum
   10           | tp_blob
   11           | addr_mapping
   12           | dp_blob
   13           | kp_blob

   14 source: BLOCK_BEGIN SOURCE STRING any_int any_int source_options BLOCK_END SOURCE

   15 source_options: %empty
   16               | source_options source_option

   17 source_option: DISPLAY_IDENTIFIER ident_or_string
   18              | qp_blob

   19 qp_blob: BLOCK_BEGIN QP_BLOB UINT qp_blob_options BLOCK_END QP_BLOB

   20 qp_blob_options: %empty
   21                | qp_blob_options qp_blob_option

   22 qp_blob_option: LENGTH UINT
   23               | CAN_ID_VARIABLE
   24               | CAN_ID_FIXED UINT
   25               | raster_value
   26               | exclusive
   27               | REDUCTION_ALLOWED
   28               | FIRST_PID UINT

   29 raster: BLOCK_BEGIN RASTER STRING STRING UINT any_int any_int exclusive_list BLOCK_END RASTER

   30 event_group: BLOCK_BEGIN EVENT_GROUP STRING STRING raster_list BLOCK_END EVENT_GROUP

   31 seed_key: BLOCK_BEGIN SEED_KEY STRING STRING STRING BLOCK_END SEED_KEY

   32 checksum: BLOCK_BEGIN CHECKSUM STRING BLOCK_END CHECKSUM

   33 tp_blob: BLOCK_BEGIN TP_BLOB UINT UINT UINT UINT UINT UINT tp_blob_options BLOCK_END TP_BLOB

   34 tp_blob_options: %empty
   35                | tp_blob_options tp_blob_option

   36 tp_blob_option: can_param
   37               | BAUDRATE UINT
   38               | SAMPLE_POINT UINT
   39               | SAMPLE_RATE UINT
   40               | BTL_CYCLES UINT
   41               | SJW UINT
   42               | SYNC_EDGE IDENT
   43               | SYNC_EDGE UINT
   44               | DAQ_MODE IDENT
   45               | BYTES_ONLY
   46               | RESUME_SUPPORTED
   47               | STORE_SUPPORTED
   48               | CONSISTENCY IDENT
   49               | ADDRESS_EXTENSION IDENT
   50               | checksum_param
   51               | defined_pages
   52               | OPTIONAL_CMD UINT

   53 can_param: BLOCK_BEGIN CAN_PARAM UINT UINT UINT BLOCK_END CAN_PARAM

   54 checksum_param: BLOCK_BEGIN CHECKSUM_PARAM UINT UINT checksum_calculation BLOCK_END CHECKSUM_PARAM

   55 checksum_calculation: %empty
   56                     | CHECKSUM_CALCULATION IDENT

   57 defined_pages: BLOCK_BEGIN DEFINED_PAGES UINT STRING UINT UINT UINT defined_pages_options BLOCK_END DEFINED_PAGES

   58 defined_pages_options: %empty
   59                      | defined_pages_options defined_pages_option

   60 defined_pages_option: RAM
   61                     | ROM
   62                     | FLASH
   63                     | EEPROM
   64                     | RAM_INIT_BY_ECU
   65                     | RAM_INIT_BY_TOOL
   66                     | AUTO_FLASH_BACK
   67                     | FLASH_BACK
   68                     | DEFAULT

   69 addr_mapping: ADDR_MAPPING UINT UINT UINT
   70             | ADDRESS_MAPPING UINT UINT UINT

   71 dp_blob: DP_BLOB UINT UINT UINT

   72 kp_blob: BLOCK_BEGIN KP_BLOB UINT UINT UINT raster_list BLOCK_END KP_BLOB
   73        | KP_BLOB UINT UINT UINT raster_list

   74 exclusive_list: %empty
   75               | exclusive_list exclusive

   76 exclusive: EXCLUSIVE any_int

   77 raster_list: %empty
   78            | raster_list raster_value

   79 raster_value: RASTER UINT
   80             | ECU_RASTER UINT

   81 any_int: INT
   82        | UINT

   83 ident_or_string: STRING
   84                | IDENT


